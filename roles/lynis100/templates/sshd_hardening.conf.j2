# {{ ansible_managed }}
# from-lynis-to-100 (SSH-7408, SSH-7440). Le port est géré dans 98-lynis-to-100-port.conf
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
TCPKeepAlive no
ClientAliveInterval {{ lynis100_ssh_client_alive_interval }}
ClientAliveCountMax {{ lynis100_ssh_client_alive_count_max }}
LogLevel VERBOSE
MaxAuthTries {{ lynis100_ssh_max_auth_tries }}
MaxSessions {{ lynis100_ssh_max_sessions }}
AllowUsers {{ lynis100_allow_users_final | join(' ') }}
